#include <stdio.h>
#include <string.h>
#include <stdbool.h>

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#include "esp_system.h"
#include "esp_random.h"        // for esp_fill_random()
#include "esp_log.h"

#include "driver/spi_common.h"
#include "driver/sdspi_host.h"
#include "sdmmc_cmd.h"
#include "esp_vfs_fat.h"

static const char *TAG = "UUID_SD";

// ===== SPI PINS (same as your working SD setup) =====
#define PIN_NUM_MISO  13
#define PIN_NUM_MOSI  11
#define PIN_NUM_CLK   12
#define PIN_NUM_CS    10

#define TOTAL_UUIDS   25     // how many UUIDs to generate
#define UUID_STR_LEN  37     // 36 chars + '\0'

// ===== UUID v4 GENERATOR (128-bit, 8-4-4-4-12) =====
static void generate_uuid_v4(char out[UUID_STR_LEN])
{
    uint8_t uuid[16];

    // 128-bit random from hardware RNG
    esp_fill_random(uuid, sizeof(uuid));

    // Version 4 (random)
    uuid[6] = (uuid[6] & 0x0F) | 0x40;

    // Variant 1 (RFC 4122)
    uuid[8] = (uuid[8] & 0x3F) | 0x80;

    // Format: 8-4-4-4-12 (36 hex chars + 4 hyphens)
    snprintf(out, UUID_STR_LEN,
             "%02X%02X%02X%02X-"
             "%02X%02X-"
             "%02X%02X-"
             "%02X%02X-"
             "%02X%02X%02X%02X%02X%02X",
             uuid[0], uuid[1], uuid[2], uuid[3],
             uuid[4], uuid[5],
             uuid[6], uuid[7],
             uuid[8], uuid[9],
             uuid[10], uuid[11], uuid[12], uuid[13], uuid[14], uuid[15]);
}

// ===== SD CARD INIT (SDSPI) =====
static esp_err_t init_sdcard(void)
{
    esp_err_t ret;
    sdmmc_card_t *card;
    const char mount_point[] = "/sdcard";

    ESP_LOGI(TAG, "Initializing SPI bus for SD...");

    spi_bus_config_t bus_cfg = {
        .mosi_io_num = PIN_NUM_MOSI,
        .miso_io_num = PIN_NUM_MISO,
        .sclk_io_num = PIN_NUM_CLK,
        .quadwp_io_num = -1,
        .quadhd_io_num = -1,
        .max_transfer_sz = 4000,
    };

    ret = spi_bus_initialize(SPI2_HOST, &bus_cfg, SDSPI_DEFAULT_DMA);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "SPI bus init failed: %s", esp_err_to_name(ret));
        return ret;
    }

    // Host for SDSPI
    sdmmc_host_t host = SDSPI_HOST_DEFAULT();
    host.slot = SPI2_HOST;

    // Slot / device config
    sdspi_device_config_t slot_config = SDSPI_DEVICE_CONFIG_DEFAULT();
    slot_config.gpio_cs = PIN_NUM_CS;
    slot_config.host_id = host.slot;

    // FATFS mount config
    esp_vfs_fat_sdmmc_mount_config_t mount_config = {
        .format_if_mount_failed = false,
        .max_files = 5,
        .allocation_unit_size = 16 * 1024
    };

    ESP_LOGI(TAG, "Mounting SD card at %s", mount_point);

    ret = esp_vfs_fat_sdspi_mount(mount_point, &host, &slot_config,
                                  &mount_config, &card);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "SD card mount failed: %s", esp_err_to_name(ret));
        return ret;
    }

    ESP_LOGI(TAG, "SD card mounted OK");
    sdmmc_card_print_info(stdout, card);
    return ESP_OK;
}

// ===== MAIN APP =====
void app_main(void)
{
    ESP_LOGI(TAG, "Booting UUID + SD Logger (25 UUIDs, 1/sec)...");

    if (init_sdcard() != ESP_OK) {
        ESP_LOGE(TAG, "SD init failed, stopping app");
        return;
    }

    // store generated UUIDs to ensure uniqueness in these 25
    char uuid_list[TOTAL_UUIDS][UUID_STR_LEN];

    const char *file_path = "/sdcard/uuid_log.txt";

    for (int i = 0; i < TOTAL_UUIDS; i++) {

        char uuid[UUID_STR_LEN];

        // generate unique UUID (compared to already generated ones)
        while (1) {
            bool duplicate = false;

            generate_uuid_v4(uuid);

            // check against previous UUIDs
            for (int j = 0; j < i; j++) {
                if (strcmp(uuid, uuid_list[j]) == 0) {
                    duplicate = true;
                    break;
                }
            }

            if (!duplicate) {
                break;  // UUID is unique in this set
            } else {
                ESP_LOGW(TAG, "Duplicate UUID generated (rare), regenerating...");
            }
        }

        // store in list
        strcpy(uuid_list[i], uuid);

        // Log to console
        ESP_LOGI(TAG, "UUID %02d/%02d: %s", i + 1, TOTAL_UUIDS, uuid);

        // Append to file
        FILE *f = fopen(file_path, "a");
        if (f == NULL) {
            ESP_LOGE(TAG, "Failed to open %s for writing", file_path);
        } else {
            // 1 UUID per line
            fprintf(f, "%s\n", uuid);
            fclose(f);
            ESP_LOGI(TAG, "Saved to file: %s", file_path);
        }

        // 1 second delay between UUIDs
        vTaskDelay(pdMS_TO_TICKS(1000));
    }

    ESP_LOGI(TAG, "Finished writing %d UUIDs to SD card. Halting.", TOTAL_UUIDS);

    // Freeze forever (or you could deep sleep here)
    while (1) {
        vTaskDelay(portMAX_DELAY);
    }
}


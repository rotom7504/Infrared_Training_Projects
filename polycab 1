/* ---------------- ACTIVE POWER ---------------- */

void inv_read_basic_block(void)
{
    uint8_t r[16];
    if(modbus_read_04(3005-1,2,r) < 9) return;

    int32_t raw =
        ((int32_t)r[3]<<24)|((int32_t)r[4]<<16)|
        ((int32_t)r[5]<<8)|r[6];

    float pac_kw = raw * 0.1f;
    ESP_LOGI(TAG,"P_AC = %.2f kW", pac_kw);

    int64_t now = esp_timer_get_time();
    if(last_energy_ts){
        double dt_hr = (now - last_energy_ts)/3600000000.0;
        esp_energy_kwh += pac_kw * dt_hr;
    }
    last_energy_ts = now;
}

/* ---------------- ENERGY TODAY ---------------- */

void inv_read_energy_block(void)
{
    uint8_t r[16];
    if(modbus_read_04(3055-1,2,r) < 9) return;

    uint32_t raw =
        ((uint32_t)r[3]<<24)|((uint32_t)r[4]<<16)|
        ((uint32_t)r[5]<<8)|r[6];

    ESP_LOGI(TAG,"E_Day = %.2f kWh | Live=%.3f kWh", raw*0.1f, esp_energy_kwh);
}

/* ---------------- TOTAL ENERGY ---------------- */

void inv_read_total_energy(void)
{
    uint8_t r[16];
    if(modbus_read_04(3007-1,2,r) < 9) return;

    uint32_t raw =
        ((uint32_t)r[3]<<24)|((uint32_t)r[4]<<16)|
        ((uint32_t)r[5]<<8)|r[6];

    ESP_LOGI(TAG,"E_TOTAL = %lu kWh", raw);
}

/* ---------------- DC POWER ---------------- */

void inv_read_dc_block(void)
{
    uint8_t r[20];
    if(modbus_read_04(3022-1,4,r) < 13) return;

    float v1=((r[3]<<8)|r[4])*0.1f;
    float i1=((int16_t)((r[5]<<8)|r[6]))*0.1f;
    float v2=((r[7]<<8)|r[8])*0.1f;
    float i2=((int16_t)((r[9]<<8)|r[10]))*0.1f;

    ESP_LOGI(TAG,"V_DC1=%.1f I_DC1=%.1f | V_DC2=%.1f I_DC2=%.1f | P_DC=%.3f kW",
             v1,i1,v2,i2,(v1*i1+v2*i2)/1000.0f);
}

/* ---------------- GRID ---------------- */

void inv_read_grid_block(void)
{
    uint8_t r[32];
    if(modbus_read_04(3034-1,6,r) < 17) return;

    float vr=((r[3]<<8)|r[4])*0.1f;
    float vy=((r[5]<<8)|r[6])*0.1f;
    float vb=((r[7]<<8)|r[8])*0.1f;
    float ir=((r[9]<<8)|r[10])*0.1f;
    float iy=((r[11]<<8)|r[12])*0.1f;
    float ib=((r[13]<<8)|r[14])*0.1f;

    if(modbus_read_04(3043-1,1,r) < 7) return;
    float f=((r[3]<<8)|r[4])*0.01f;

    ESP_LOGI(TAG,"V_AC=%.1f %.1f %.1f | I_AC=%.1f %.1f %.1f | F=%.2f",
             vr,vy,vb,ir,iy,ib,f);
}

/* ---------------- Q & S POWER ---------------- */

void inv_read_qs_block(void)
{
    uint8_t r[16];
    if(modbus_read_04(3011-1,2,r) < 9) return;

    int32_t q = ((int32_t)r[3]<<24)|((int32_t)r[4]<<16)|
                ((int32_t)r[5]<<8)|r[6];

    if(modbus_read_04(3013-1,2,r) < 9) return;

    int32_t s = ((int32_t)r[3]<<24)|((int32_t)r[4]<<16)|
                ((int32_t)r[5]<<8)|r[6];

    ESP_LOGI(TAG,"Q_AC=%.2f kvar | S_AC=%.2f kVA", q*0.1f, s*0.1f);
}

/* ---------------- TEMPERATURE ---------------- */

void inv_read_temp(void)
{
    uint8_t r[8];
    if(modbus_read_04(3101-1,1,r) < 7) return;
    ESP_LOGI(TAG,"TEMP_001=%.1f C", ((int16_t)((r[3]<<8)|r[4]))*0.1f);
}

/* ---------------- STATUS ---------------- */

void inv_read_status_block(void)
{
    uint8_t r[8];
    if(modbus_read_04(3201-1,1,r) < 7) return;
    ESP_LOGI(TAG,"STATUS=%u",(r[3]<<8)|r[4]);
}

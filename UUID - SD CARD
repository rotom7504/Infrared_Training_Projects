#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "alarm_store128.h"
#include "esp_log.h"

static const char *TAG = "MAIN128";

void app_main(void)
{
    esp_err_t r = alarm_store_init("/sdcard");
    if (r != ESP_OK) {
        ESP_LOGW(TAG, "Alarm store init returned %s - ensure SD mounted", esp_err_to_name(r));
    }

    // Example aUUIDs (32-hex). Usually these arrive from network/serial packets.
    const char *hex1 = "00112233445566778899AABBCCDDEEFF";
    const char *hex2 = "A1B2C3D4E5F60718293A4B5C6D7E8F90";
    uuid128_t u1, u2;
    if (!uuid128_from_hexstr(hex1, &u1) || !uuid128_from_hexstr(hex2, &u2)) {
        ESP_LOGE(TAG, "Invalid sample hex");
        return;
    }

    bool added;
    alarm_add_if_new(&u1, &added);
    ESP_LOGI(TAG, "u1 added? %d", added);

    // duplicate attempt -> should not add or notify
    alarm_add_if_new(&u1, &added);
    ESP_LOGI(TAG, "u1 added again? %d", added);

    // add u2
    alarm_add_if_new(&u2, &added);
    ESP_LOGI(TAG, "u2 added? %d", added);

    // clear u1
    bool removed;
    alarm_clear(&u1, &removed);
    ESP_LOGI(TAG, "u1 cleared? %d", removed);

    // check state
    ESP_LOGI(TAG, "u1 active? %d", alarm_is_active(&u1));
    ESP_LOGI(TAG, "u2 active? %d", alarm_is_active(&u2));

    while (1) vTaskDelay(pdMS_TO_TICKS(10000));
}


alarm_store128.h
#pragma once
#include <stdint.h>
#include <stdbool.h>
#include "esp_err.h"

#define UUID128_LEN 16

typedef struct {
    uint8_t b[UUID128_LEN];
} uuid128_t;

// Initialize alarm store and mount SD (mount_point e.g. "/sdcard")
esp_err_t alarm_store_init(const char *mount_point);

// Deinitialize (unmount SD, free memory)
void alarm_store_deinit(void);

// Check whether uuid is active
bool alarm_is_active(const uuid128_t *uuid);

// Add uuid if new; was_added==true means caller should notify/pop-up
esp_err_t alarm_add_if_new(const uuid128_t *uuid, bool *was_added);

// Clear uuid if present; was_removed==true means caller should notify server clear
esp_err_t alarm_clear(const uuid128_t *uuid, bool *was_removed);

// Helpers: format uuid to 32-hex string (buf >= 33), parse hex string to uuid
int uuid128_to_string(const uuid128_t *uuid, char *buf, size_t buf_len);
bool uuid128_from_hexstr(const char *hex, uuid128_t *out);


alarm_store128.c
// alarm_store128.c
#include "alarm_store128.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "esp_log.h"
#include "esp_err.h"
#include "freertos/FreeRTOS.h"
#include "freertos/semphr.h"
#include "esp_vfs_fat.h"
#include "sdmmc_cmd.h"

static const char *TAG = "ALARM128";
static const char *ALARM_FILE = "/sdcard/active_alarms.txt";
static const char *TEMP_FILE  = "/sdcard/active_alarms.tmp";

typedef struct {
    uuid128_t *items;
    size_t count;
    size_t capacity;
} uuid_set_t;

static uuid_set_t g_set = {0};
static SemaphoreHandle_t g_mutex = NULL;
static bool g_initialized = false;

// ---------- low-level helpers ----------
static void uuid_zero(uuid128_t *u) { memset(u->b, 0, UUID128_LEN); }
static int uuid_cmp(const uuid128_t *a, const uuid128_t *b) { return memcmp(a->b, b->b, UUID128_LEN); }

// ensure capacity
static esp_err_t ensure_capacity(size_t min)
{
    if (g_set.capacity >= min) return ESP_OK;
    size_t ncap = g_set.capacity ? g_set.capacity * 2 : 64;
    while (ncap < min) ncap *= 2;
    uuid128_t *n = realloc(g_set.items, ncap * sizeof(uuid128_t));
    if (!n) return ESP_ERR_NO_MEM;
    g_set.items = n;
    g_set.capacity = ncap;
    return ESP_OK;
}

static bool set_contains_locked(const uuid128_t *id)
{
    for (size_t i = 0; i < g_set.count; ++i) {
        if (uuid_cmp(&g_set.items[i], id) == 0) return true;
    }
    return false;
}

static esp_err_t set_add_locked(const uuid128_t *id)
{
    if (set_contains_locked(id)) return ESP_OK;
    esp_err_t e = ensure_capacity(g_set.count + 1);
    if (e != ESP_OK) return e;
    g_set.items[g_set.count++] = *id;
    return ESP_OK;
}

static bool set_remove_locked(const uuid128_t *id)
{
    for (size_t i = 0; i < g_set.count; ++i) {
        if (uuid_cmp(&g_set.items[i], id) == 0) {
            // swap-remove
            g_set.items[i] = g_set.items[g_set.count - 1];
            g_set.count--;
            return true;
        }
    }
    return false;
}

// ---------- hex helpers ----------
static int hexchar_to_nibble(char c)
{
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'A' && c <= 'F') return 10 + (c - 'A');
    if (c >= 'a' && c <= 'f') return 10 + (c - 'a');
    return -1;
}

bool uuid128_from_hexstr(const char *hex, uuid128_t *out)
{
    if (!hex || !out) return false;
    // allow optional "0x" prefix
    if (hex[0] == '0' && (hex[1] == 'x' || hex[1] == 'X')) hex += 2;
    // must be exactly 32 hex chars
    size_t len = strlen(hex);
    if (len != 32) return false;
    for (size_t i = 0; i < UUID128_LEN; ++i) {
        int hi = hexchar_to_nibble(hex[i*2]);
        int lo = hexchar_to_nibble(hex[i*2 + 1]);
        if (hi < 0 || lo < 0) return false;
        out->b[i] = (uint8_t)((hi << 4) | lo);
    }
    return true;
}

int uuid128_to_string(const uuid128_t *uuid, char *buf, size_t buf_len)
{
    if (!uuid || !buf || buf_len < 33) return -1;
    const char *hex = "0123456789ABCDEF";
    for (size_t i = 0; i < UUID128_LEN; ++i) {
        buf[i*2]     = hex[(uuid->b[i] >> 4) & 0xF];
        buf[i*2 + 1] = hex[uuid->b[i] & 0xF];
    }
    buf[32] = '\0';
    return 32;
}

// ---------- persistence (atomic) ----------
static esp_err_t persist_to_sd_locked(void)
{
    FILE *f = fopen(TEMP_FILE, "w");
    if (!f) {
        ESP_LOGE(TAG, "open temp file failed");
        return ESP_FAIL;
    }
    // write one 32-hex line per uuid
    char line[40];
    for (size_t i = 0; i < g_set.count; ++i) {
        uuid128_to_string(&g_set.items[i], line, sizeof(line));
        strcat(line, "\n");
        if (fputs(line, f) == EOF) {
            fclose(f);
            ESP_LOGE(TAG, "write temp failed");
            return ESP_FAIL;
        }
    }
    fflush(f);
    fsync(fileno(f));
    fclose(f);

    // atomic rename
    if (rename(TEMP_FILE, ALARM_FILE) != 0) {
        ESP_LOGE(TAG, "rename failed");
        return ESP_FAIL;
    }
    return ESP_OK;
}

static esp_err_t load_from_sd_locked(void)
{
    FILE *f = fopen(ALARM_FILE, "r");
    if (!f) {
        ESP_LOGW(TAG, "No existing alarm file");
        return ESP_OK;
    }
    char buf[64];
    while (fgets(buf, sizeof(buf), f)) {
        // trim newline
        char *nl = strchr(buf, '\n');
        if (nl) *nl = '\0';
        if (buf[0] == '\0') continue;
        uuid128_t u;
        if (uuid128_from_hexstr(buf, &u)) {
            set_add_locked(&u);
        } else {
            ESP_LOGW(TAG, "Skipping invalid line: %s", buf);
        }
    }
    fclose(f);
    return ESP_OK;
}

// ---------- public API ----------
esp_err_t alarm_store_init(const char *mount_point)
{
    if (g_initialized) return ESP_OK;

    g_mutex = xSemaphoreCreateMutex();
    if (!g_mutex) {
        ESP_LOGE(TAG, "mutex create failed");
        return ESP_ERR_NO_MEM;
    }

    // Try to mount SD card (if user already mounted, they can skip this step)
    sdmmc_card_t *card;
    sdmmc_host_t host = SDMMC_HOST_DEFAULT();
    sdmmc_slot_config_t slot_config = SDMMC_SLOT_CONFIG_DEFAULT();
    esp_vfs_fat_sdmmc_mount_config_t mcfg = {
        .format_if_mount_failed = false,
        .max_files = 5,
        .allocation_unit_size = 16 * 1024
    };
    esp_err_t err = esp_vfs_fat_sdmmc_mount(mount_point, &host, &slot_config, &mcfg, &card);
    if (err != ESP_OK) {
        ESP_LOGW(TAG, "sd mount returned %s - if SD already mounted elsewhere, ignore", esp_err_to_name(err));
        // continue: maybe mount is done externally
    }

    xSemaphoreTake(g_mutex, portMAX_DELAY);
    err = load_from_sd_locked();
    xSemaphoreGive(g_mutex);

    if (err != ESP_OK) {
        ESP_LOGW(TAG, "load_from_sd returned %s", esp_err_to_name(err));
    }

    g_initialized = true;
    ESP_LOGI(TAG, "Alarm store init complete, loaded %d uuids", (int)g_set.count);
    return ESP_OK;
}

void alarm_store_deinit(void)
{
    if (!g_initialized) return;
    xSemaphoreTake(g_mutex, portMAX_DELAY);
    if (g_set.items) free(g_set.items);
    g_set.items = NULL;
    g_set.count = g_set.capacity = 0;
    xSemaphoreGive(g_mutex);
    vSemaphoreDelete(g_mutex);
    g_mutex = NULL;
    // optional: unmount
    esp_vfs_fat_sdmmc_unmount();
    g_initialized = false;
}

bool alarm_is_active(const uuid128_t *uuid)
{
    bool r = false;
    xSemaphoreTake(g_mutex, portMAX_DELAY);
    r = set_contains_locked(uuid);
    xSemaphoreGive(g_mutex);
    return r;
}

esp_err_t alarm_add_if_new(const uuid128_t *uuid, bool *was_added)
{
    if (!was_added) return ESP_ERR_INVALID_ARG;
    *was_added = false;
    esp_err_t err = ESP_OK;
    xSemaphoreTake(g_mutex, portMAX_DELAY);
    if (!set_contains_locked(uuid)) {
        err = set_add_locked(uuid);
        if (err == ESP_OK) {
            if (persist_to_sd_locked() == ESP_OK) {
                *was_added = true;
            } else {
                // rollback
                set_remove_locked(uuid);
                err = ESP_FAIL;
            }
        }
    }
    xSemaphoreGive(g_mutex);
    return err;
}

esp_err_t alarm_clear(const uuid128_t *uuid, bool *was_removed)
{
    if (!was_removed) return ESP_ERR_INVALID_ARG;
    *was_removed = false;
    esp_err_t err = ESP_OK;
    xSemaphoreTake(g_mutex, portMAX_DELAY);
    if (set_remove_locked(uuid)) {
        if (persist_to_sd_locked() == ESP_OK) {
            *was_removed = true;
        } else {
            // cannot easily rollback removal; report failure
            err = ESP_FAIL;
        }
    }
    xSemaphoreGive(g_mutex);
    return err;
}



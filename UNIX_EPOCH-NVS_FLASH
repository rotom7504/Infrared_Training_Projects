static const char *TAG = "MAIN";

#define NVS_NAMESPACE_TIME  "time_store"
#define NVS_KEY_UNIX_TIME   "last_unix"

static esp_err_t nvs_init_safe(void)
{
    esp_err_t ret = nvs_flash_init();
    if (ret == ESP_ERR_NVS_NO_FREE_PAGES || ret == ESP_ERR_NVS_NEW_VERSION_FOUND) {
        ESP_ERROR_CHECK(nvs_flash_erase());
        ret = nvs_flash_init();
    }
    if (ret == ESP_OK) {
        ESP_LOGI(TAG, "NVS init OK");
    } else {
        ESP_LOGE(TAG, "NVS init failed: %s", esp_err_to_name(ret));
    }
    return ret;
}

static void initialize_sntp(void)
{
    ESP_LOGI(TAG, "Initializing SNTP");
    sntp_setoperatingmode(SNTP_OPMODE_POLL);
    sntp_setservername(0, "pool.ntp.org");
    sntp_init();
}

static esp_err_t obtain_time_via_sntp(void)
{
    initialize_sntp();

    time_t now = 0;
    struct tm timeinfo = {0};
    int retry = 0;
    const int retry_count = 10;

    while (retry < retry_count) {
        time(&now);
        localtime_r(&now, &timeinfo);

        // treat year >= 2024 as "valid" SNTP time
        if ((timeinfo.tm_year + 1900) >= 2024) {
            ESP_LOGI(TAG, "SNTP time: %04d-%02d-%02d %02d:%02d:%02d (Unix: %ld)",
                     timeinfo.tm_year + 1900,
                     timeinfo.tm_mon + 1,
                     timeinfo.tm_mday,
                     timeinfo.tm_hour,
                     timeinfo.tm_min,
                     timeinfo.tm_sec,
                     (long)now);
            return ESP_OK;
        }

        ESP_LOGI(TAG, "Waiting for SNTP time... (%d/%d)", retry + 1, retry_count);
        retry++;
        vTaskDelay(pdMS_TO_TICKS(2000));
    }

    ESP_LOGW(TAG, "SNTP sync did not complete in time");
    return ESP_FAIL;
}

static esp_err_t set_system_time_from_tm(const struct tm *timeinfo)
{
    if (!timeinfo) return ESP_ERR_INVALID_ARG;

    time_t now = mktime((struct tm *)timeinfo);
    if (now == (time_t)-1) {
        ESP_LOGE(TAG, "mktime failed");
        return ESP_FAIL;
    }

    struct timeval tv = {
        .tv_sec = now,
        .tv_usec = 0
    };
    settimeofday(&tv, NULL);

    ESP_LOGI(TAG, "System time set from struct tm: %04d-%02d-%02d %02d:%02d:%02d (Unix: %ld)",
             timeinfo->tm_year + 1900,
             timeinfo->tm_mon + 1,
             timeinfo->tm_mday,
             timeinfo->tm_hour,
             timeinfo->tm_min,
             timeinfo->tm_sec,
             (long)now);

    return ESP_OK;
}

static esp_err_t set_system_time_from_unix(time_t unix_time)
{
    if (unix_time <= 0) {
        return ESP_ERR_INVALID_ARG;
    }

    struct timeval tv = {
        .tv_sec = unix_time,
        .tv_usec = 0
    };
    settimeofday(&tv, NULL);

    struct tm timeinfo;
    localtime_r(&unix_time, &timeinfo);

    ESP_LOGI(TAG, "System time set from NVS Unix: %04d-%02d-%02d %02d:%02d:%02d (Unix: %ld)",
             timeinfo.tm_year + 1900,
             timeinfo.tm_mon + 1,
             timeinfo.tm_mday,
             timeinfo.tm_hour,
             timeinfo.tm_min,
             timeinfo.tm_sec,
             (long)unix_time);

    return ESP_OK;
}

static esp_err_t nvs_save_unix_time(time_t unix_time)
{
    nvs_handle_t nvs;
    esp_err_t err = nvs_open(NVS_NAMESPACE_TIME, NVS_READWRITE, &nvs);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "nvs_open failed: %s", esp_err_to_name(err));
        return err;
    }

    err = nvs_set_i64(nvs, NVS_KEY_UNIX_TIME, (int64_t)unix_time);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "nvs_set_i64 failed: %s", esp_err_to_name(err));
        nvs_close(nvs);
        return err;
    }

    err = nvs_commit(nvs);
    nvs_close(nvs);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "nvs_commit failed: %s", esp_err_to_name(err));
        return err;
    }

    ESP_LOGI(TAG, "Saved Unix time %ld to NVS", (long)unix_time);
    return ESP_OK;
}

static esp_err_t nvs_load_unix_time(time_t *unix_time_out)
{
    if (!unix_time_out) return ESP_ERR_INVALID_ARG;

    nvs_handle_t nvs;
    esp_err_t err = nvs_open(NVS_NAMESPACE_TIME, NVS_READONLY, &nvs);
    if (err != ESP_OK) {
        ESP_LOGI(TAG, "No NVS time namespace yet");
        return err;
    }

    int64_t stored = 0;
    err = nvs_get_i64(nvs, NVS_KEY_UNIX_TIME, &stored);
    nvs_close(nvs);

    if (err == ESP_OK) {
        *unix_time_out = (time_t)stored;
        ESP_LOGI(TAG, "Loaded Unix time %ld from NVS", (long)*unix_time_out);
    } else {
        ESP_LOGI(TAG, "No valid time in NVS (key missing)");
    }

    return err;
}

void app_main(void)
{
    ESP_LOGI(TAG, "System start");

    // 1) NVS init
    nvs_init_safe();

    // 2) Try DS1307 as primary source
    bool rtc_ok = false;
    struct tm rtc_time = {0};

    esp_err_t err_rtc_init = ds1307_init();
    if (err_rtc_init == ESP_OK) {
        err_rtc_init = ds1307_get_time(&rtc_time);
        if (err_rtc_init == ESP_OK) {
            int year = rtc_time.tm_year + 1900;
            if (year >= 2024) {
                rtc_ok = true;
                ESP_LOGI(TAG,
                         "Valid DS1307 time at boot: %04d-%02d-%02d %02d:%02d:%02d",
                         year,
                         rtc_time.tm_mon + 1,
                         rtc_time.tm_mday,
                         rtc_time.tm_hour,
                         rtc_time.tm_min,
                         rtc_time.tm_sec);
                set_system_time_from_tm(&rtc_time);
            } else {
                ESP_LOGW(TAG, "DS1307 time looks invalid (year=%d)", year);
            }
        } else {
            ESP_LOGW(TAG, "DS1307 read failed at boot: %s", esp_err_to_name(err_rtc_init));
        }
    } else {
        ESP_LOGW(TAG, "DS1307 init failed at boot: %s", esp_err_to_name(err_rtc_init));
    }

    // 3) If DS1307 invalid, try NVS
    bool nvs_time_ok = false;
    time_t nvs_unix = 0;

    if (!rtc_ok) {
        ESP_LOGW(TAG, "No valid DS1307 time at boot, trying NVS");
        if (nvs_load_unix_time(&nvs_unix) == ESP_OK && nvs_unix > 0) {
            nvs_time_ok = true;
            set_system_time_from_unix(nvs_unix);
        } else {
            ESP_LOGW(TAG, "No valid time in NVS either. WiFi + SNTP required.");
        }
    }

    // 4) If both DS1307 and NVS invalid, use WiFi + SNTP once
    if (!rtc_ok && !nvs_time_ok) {
        ESP_LOGI(TAG, "Starting WiFi for initial SNTP sync...");
        wifi_init_sta();   // your existing WiFi code

        if (obtain_time_via_sntp() == ESP_OK) {
            time_t now;
            time(&now);

            // Save to NVS
            nvs_save_unix_time(now);

            // Also seed DS1307 if it initialized OK
            if (ds1307_init() == ESP_OK) {
                struct tm timeinfo;
                localtime_r(&now, &timeinfo);
                ds1307_set_time(&timeinfo);
            }
        } else {
            ESP_LOGW(TAG, "SNTP time not obtained, system time may be invalid");
        }
    } else if (rtc_ok) {
        // DS1307 was valid at boot, also keep NVS in sync
        time_t now = mktime(&rtc_time);
        if (now > 0) {
            nvs_save_unix_time(now);
        }
    } else if (nvs_time_ok) {
        // NVS used at boot; try to also update DS1307
        if (ds1307_init() == ESP_OK) {
            struct tm timeinfo;
            localtime_r(&nvs_unix, &timeinfo);
            ds1307_set_time(&timeinfo);
        }
    }

    // 5) Main loop: heartbeat + periodic NVS backup
    int heartbeat = 0;
    int nvs_counter = 0;  // every few heartbeats, save to NVS

    while (1) {
        time_t now;
        struct tm timeinfo;
        time(&now);
        localtime_r(&now, &timeinfo);

        ESP_LOGI(TAG,
                 "Heartbeat %d | Time: %04d-%02d-%02d %02d:%02d:%02d | Unix: %ld | Heap: %u",
                 ++heartbeat,
                 timeinfo.tm_year + 1900,
                 timeinfo.tm_mon + 1,
                 timeinfo.tm_mday,
                 timeinfo.tm_hour,
                 timeinfo.tm_min,
                 timeinfo.tm_sec,
                 (long)now,
                 (unsigned)esp_get_free_heap_size());

        // Every 3 heartbeats (~60s if delay is 20s), save Unix time to NVS
        nvs_counter++;
        if (nvs_counter >= 3) {
            nvs_counter = 0;
            if (now > 0) {
                nvs_save_unix_time(now);
            }
        }

        vTaskDelay(pdMS_TO_TICKS(20000));  // 20 seconds
    }
}

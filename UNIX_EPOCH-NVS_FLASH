// main/nvs_utils.c
#include "sdkconfig.h"
#include "nvs_utils.h"
#include "nvs.h"
#include "nvs_flash.h"
#include "esp_log.h"

static const char *TAG = "NVS_UTILS";
#define NAMESPACE "rtc_backup"
#define KEY_LAST "last_unix"

esp_err_t nvs_utils_save_last_unix(uint64_t unix_ts)
{
    nvs_handle_t h;
    esp_err_t err = nvs_open(NAMESPACE, NVS_READWRITE, &h);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "nvs_open failed");
        return err;
    }
    err = nvs_set_u64(h, KEY_LAST, unix_ts);
    if (err == ESP_OK) nvs_commit(h);
    nvs_close(h);
    return err;
}

esp_err_t nvs_utils_load_last_unix(uint64_t *unix_ts_out)
{
    nvs_handle_t h;
    esp_err_t err = nvs_open(NAMESPACE, NVS_READONLY, &h);
    if (err != ESP_OK) return err;
    uint64_t val = 0;
    err = nvs_get_u64(h, KEY_LAST, &val);
    if (err == ESP_OK && unix_ts_out) *unix_ts_out = val;
    nvs_close(h);
    return err;
}


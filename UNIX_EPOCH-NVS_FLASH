#include <stdio.h>
#include <string.h>
#include <stdbool.h>
#include <time.h>
#include "esp_log.h"
#include "esp_err.h"
#include "driver/i2c.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#include "ds1307.h"

#define DS1307_TAG        "DS1307"

#define DS1307_I2C_PORT   I2C_NUM_0
#define DS1307_SDA_GPIO   8
#define DS1307_SCL_GPIO   9
#define DS1307_ADDR       0x68

#define DS1307_REG_SECONDS 0x00

static const char *TAG = DS1307_TAG;

static bool s_i2c_initialized = false;

static uint8_t dec2bcd(uint8_t val)
{
    return ((val / 10) << 4) | (val % 10);
}

static uint8_t bcd2dec(uint8_t val)
{
    return (uint8_t)((val >> 4) * 10 + (val & 0x0F));
}

esp_err_t ds1307_init(void)
{
    esp_err_t err;

    if (!s_i2c_initialized) {
        ESP_LOGI(TAG, "Initializing DS1307 I2C, SDA=%d SCL=%d", DS1307_SDA_GPIO, DS1307_SCL_GPIO);

        i2c_config_t conf = {
            .mode = I2C_MODE_MASTER,
            .sda_io_num = DS1307_SDA_GPIO,
            .scl_io_num = DS1307_SCL_GPIO,
            .sda_pullup_en = GPIO_PULLUP_ENABLE,
            .scl_pullup_en = GPIO_PULLUP_ENABLE,
            .master.clk_speed = 100000,
        };

        err = i2c_param_config(DS1307_I2C_PORT, &conf);
        if (err != ESP_OK) {
            ESP_LOGE(TAG, "i2c_param_config failed: %s", esp_err_to_name(err));
            return err;
        }

        err = i2c_driver_install(DS1307_I2C_PORT, conf.mode, 0, 0, 0);
        if (err != ESP_OK && err != ESP_ERR_INVALID_STATE) {
            ESP_LOGE(TAG, "i2c_driver_install failed: %s", esp_err_to_name(err));
            return err;
        }

        s_i2c_initialized = true;
    } else {
        ESP_LOGD(TAG, "I2C already initialized, skipping re-init");
    }

    // Ping DS1307: read 1 byte from register 0x00
    uint8_t reg = DS1307_REG_SECONDS;
    uint8_t data = 0;

    err = i2c_master_write_read_device(DS1307_I2C_PORT,
                                       DS1307_ADDR,
                                       &reg, 1,
                                       &data, 1,
                                       1000 / portTICK_PERIOD_MS);

    if (err != ESP_OK) {
        ESP_LOGW(TAG, "DS1307 not responding: %s", esp_err_to_name(err));
        return err;
    }

    ESP_LOGI(TAG, "DS1307 init complete");
    return ESP_OK;
}

esp_err_t ds1307_get_time(struct tm *timeinfo)
{
    if (!timeinfo) {
        return ESP_ERR_INVALID_ARG;
    }

    uint8_t reg = DS1307_REG_SECONDS;
    uint8_t data[7] = {0};

    esp_err_t err = i2c_master_write_read_device(DS1307_I2C_PORT,
                                                 DS1307_ADDR,
                                                 &reg, 1,
                                                 data, 7,
                                                 1000 / portTICK_PERIOD_MS);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to read time from DS1307: %s", esp_err_to_name(err));
        return err;
    }

    uint8_t seconds = bcd2dec(data[0] & 0x7F);  // bit7 = CH (clock halt)
    uint8_t minutes = bcd2dec(data[1] & 0x7F);

    uint8_t hour_reg = data[2];
    uint8_t hours;
    if (hour_reg & 0x40) {
        // 12-hour mode
        hours = bcd2dec(hour_reg & 0x1F);
        bool pm = hour_reg & 0x20;
        if (pm && hours < 12) {
            hours += 12;
        }
        if (!pm && hours == 12) {
            hours = 0;
        }
    } else {
        // 24-hour mode
        hours = bcd2dec(hour_reg & 0x3F);
    }

    uint8_t day    = bcd2dec(data[4]);
    uint8_t month  = bcd2dec(data[5]);
    uint8_t year   = bcd2dec(data[6]);  // 0-99, offset from 2000

    memset(timeinfo, 0, sizeof(struct tm));
    timeinfo->tm_sec  = seconds;
    timeinfo->tm_min  = minutes;
    timeinfo->tm_hour = hours;
    timeinfo->tm_mday = day;
    timeinfo->tm_mon  = month - 1;         // tm_mon: 0-11
    timeinfo->tm_year = year + 100;        // tm_year: years since 1900, so 100 = 2000

    return ESP_OK;
}

esp_err_t ds1307_set_time(const struct tm *timeinfo)
{
    if (!timeinfo) {
        return ESP_ERR_INVALID_ARG;
    }

    uint8_t data[8];
    data[0] = DS1307_REG_SECONDS;

    // Clear CH bit (bit 7) to start oscillator
    data[1] = dec2bcd(timeinfo->tm_sec & 0x7F);
    data[2] = dec2bcd(timeinfo->tm_min & 0x7F);
    data[3] = dec2bcd(timeinfo->tm_hour & 0x3F);  // 24-hour mode

    // Day of week (not really used here, set 1..7 arbitrarily)
    data[4] = 1;

    data[5] = dec2bcd(timeinfo->tm_mday);
    data[6] = dec2bcd((timeinfo->tm_mon + 1) & 0x1F);

    int year = timeinfo->tm_year + 1900;  // convert from offset
    if (year < 2000) year = 2000;
    data[7] = dec2bcd((uint8_t)(year - 2000));

    esp_err_t err = i2c_master_write_to_device(DS1307_I2C_PORT,
                                               DS1307_ADDR,
                                               data, sizeof(data),
                                               1000 / portTICK_PERIOD_MS);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to set time on DS1307: %s", esp_err_to_name(err));
        return err;
    }

    ESP_LOGI(TAG, "RTC updated: %04d-%02d-%02d %02d:%02d:%02d",
             year,
             timeinfo->tm_mon + 1,
             timeinfo->tm_mday,
             timeinfo->tm_hour,
             timeinfo->tm_min,
             timeinfo->tm_sec);

    return ESP_OK;
}


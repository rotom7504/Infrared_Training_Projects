#pragma once

#include <stdbool.h>

/* Start SNTP time synchronization */
void time_sync_start(void);

/* Returns true if system time is valid */
bool time_sync_is_valid(void);


#include "time_sync.h"

#include <time.h>

#include "esp_log.h"
#include "esp_sntp.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

static const char *TAG = "TIME_SYNC";
static bool time_valid = false;

void time_sync_start(void)
{
    ESP_LOGI(TAG, "Starting SNTP time sync");

    sntp_setoperatingmode(SNTP_OPMODE_POLL);
    sntp_setservername(0, "pool.ntp.org");
    sntp_init();

    time_t now = 0;
    struct tm timeinfo = {0};

    for (int i = 0; i < 10; i++) {
        time(&now);
        localtime_r(&now, &timeinfo);

        if (timeinfo.tm_year >= (2019 - 1900)) {
            time_valid = true;
            ESP_LOGI(TAG, "System time synced and valid");
            return;
        }

        vTaskDelay(pdMS_TO_TICKS(1000));
    }

    time_valid = false;
    ESP_LOGW(TAG, "Time sync failed or invalid");
}

bool time_sync_is_valid(void)
{
    return time_valid;
}


#pragma once

#include "freertos/FreeRTOS.h"
#include "freertos/event_groups.h"

/* WiFi connected event bit */
#define WIFI_CONNECTED_BIT BIT0

/* Start WiFi in normal mode (AP + STA) */
void wifi_manager_start(void);

/* Start WiFi in SAFE MODE (AP only) */
void wifi_manager_start_ap_only(void);

/* Get WiFi event group */
EventGroupHandle_t wifi_manager_get_event_group(void);


#include "wifi_manager.h"

#include <string.h>

#include "esp_log.h"
#include "esp_event.h"
#include "esp_netif.h"
#include "esp_wifi.h"
#include "driver/gpio.h"

/* ---------------- CONFIG ---------------- */

#define WIFI_STA_SSID   "Airtel_IRPTECHSOL"
#define WIFI_STA_PASS   "9829479078"

#define WIFI_AP_SSID    "ESP32-OTA"
#define WIFI_AP_PASS    "12345678"
#define WIFI_AP_CHANNEL 8

#define WIFI_MAX_RETRY  10
#define LED_GPIO        GPIO_NUM_15

/* ---------------------------------------- */

static const char *TAG = "WIFI_MANAGER";

static EventGroupHandle_t wifi_event_group;
static int retry_count = 0;

/* ---------------- EVENT HANDLER ---------------- */

static void wifi_event_handler(void *arg,
                               esp_event_base_t event_base,
                               int32_t event_id,
                               void *event_data)
{
    if (event_base == WIFI_EVENT &&
        event_id == WIFI_EVENT_STA_START) {

        ESP_LOGI(TAG, "STA started, connecting...");
        esp_wifi_connect();
    }

    else if (event_base == WIFI_EVENT &&
             event_id == WIFI_EVENT_STA_DISCONNECTED) {

        xEventGroupClearBits(wifi_event_group, WIFI_CONNECTED_BIT);
        gpio_set_level(LED_GPIO, 0);

        if (retry_count < WIFI_MAX_RETRY) {
            retry_count++;
            ESP_LOGW(TAG,
                     "WiFi disconnected, retry %d/%d",
                     retry_count, WIFI_MAX_RETRY);
            esp_wifi_connect();
        } else {
            ESP_LOGE(TAG,
                     "WiFi reconnect failed, giving up");
            retry_count = 0;
        }
    }

    else if (event_base == IP_EVENT &&
             event_id == IP_EVENT_STA_GOT_IP) {

        retry_count = 0;
        gpio_set_level(LED_GPIO, 1);
        xEventGroupSetBits(wifi_event_group, WIFI_CONNECTED_BIT);

        ESP_LOGI(TAG, "WiFi connected, IP acquired");
    }
}

/* ---------------- COMMON INIT ---------------- */

static void wifi_common_init(void)
{
    static bool initialized = false;
    if (initialized) return;
    initialized = true;

    wifi_event_group = xEventGroupCreate();

    ESP_ERROR_CHECK(esp_netif_init());
    ESP_ERROR_CHECK(esp_event_loop_create_default());

    gpio_reset_pin(LED_GPIO);
    gpio_set_direction(LED_GPIO, GPIO_MODE_OUTPUT);
    gpio_set_level(LED_GPIO, 0);

    ESP_LOGI(TAG, "WiFi common init done");
}

/* ---------------- NORMAL MODE ---------------- */

void wifi_manager_start(void)
{
    wifi_common_init();

    esp_netif_create_default_wifi_sta();
    esp_netif_create_default_wifi_ap();

    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(esp_wifi_init(&cfg));

    ESP_ERROR_CHECK(esp_event_handler_register(
        WIFI_EVENT, ESP_EVENT_ANY_ID, wifi_event_handler, NULL));
    ESP_ERROR_CHECK(esp_event_handler_register(
        IP_EVENT, IP_EVENT_STA_GOT_IP, wifi_event_handler, NULL));

    wifi_config_t sta_cfg = {0};
    strcpy((char *)sta_cfg.sta.ssid, WIFI_STA_SSID);
    strcpy((char *)sta_cfg.sta.password, WIFI_STA_PASS);

    wifi_config_t ap_cfg = {
        .ap = {
            .ssid = WIFI_AP_SSID,
            .ssid_len = strlen(WIFI_AP_SSID),
            .password = WIFI_AP_PASS,
            .channel = WIFI_AP_CHANNEL,
            .max_connection = 4,
            .authmode = WIFI_AUTH_WPA2_PSK
        }
    };

    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_APSTA));
    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &sta_cfg));
    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_AP, &ap_cfg));
    ESP_ERROR_CHECK(esp_wifi_start());

    ESP_LOGI(TAG, "WiFi started (AP + STA)");
}

/* ---------------- SAFE MODE ---------------- */

void wifi_manager_start_ap_only(void)
{
    wifi_common_init();

    esp_netif_create_default_wifi_ap();

    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(esp_wifi_init(&cfg));

    wifi_config_t ap_cfg = {
        .ap = {
            .ssid = WIFI_AP_SSID,
            .ssid_len = strlen(WIFI_AP_SSID),
            .password = WIFI_AP_PASS,
            .channel = WIFI_AP_CHANNEL,
            .max_connection = 2,
            .authmode = WIFI_AUTH_WPA2_PSK
        }
    };

    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_AP));
    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_AP, &ap_cfg));
    ESP_ERROR_CHECK(esp_wifi_start());

    ESP_LOGW(TAG, "WiFi SAFE MODE active (AP only)");
}

/* ---------------- API ---------------- */

EventGroupHandle_t wifi_manager_get_event_group(void)
{
    return wifi_event_group;
}

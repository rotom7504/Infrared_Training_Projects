static const char *TAG = "DEVICE_ID";

static char device_id[32] = {0};

void device_identity_init(void)
{
    uint8_t mac[6] = {0};

    if (esp_read_mac(mac, ESP_MAC_WIFI_STA) != ESP_OK) {
        strcpy(device_id, "UNKNOWN");
        ESP_LOGE(TAG, "Failed to read MAC");
        return;
    }

    snprintf(device_id, sizeof(device_id),
             "ESP32S3-%02X%02X%02X%02X%02X%02X",
             mac[0], mac[1], mac[2],
             mac[3], mac[4], mac[5]);

    ESP_LOGI(TAG, "Device ID: %s", device_id);
}

const char *device_identity_get_id(void)
{
    return device_id;
}

void device_identity_get_mac(uint8_t mac[6])
{
    if (!mac) return;
    esp_read_mac(mac, ESP_MAC_WIFI_STA);
}

void device_control_reboot(void)
{
    ESP_LOGW(TAG, "AUDIT: Controlled reboot");
    esp_restart();
}

void device_control_factory_reset(void)
{
    ESP_LOGW(TAG, "AUDIT: Factory reset initiated");

    if (nvs_flash_erase() == ESP_OK) {
        ESP_LOGI(TAG, "NVS erased");
    } else {
        ESP_LOGE(TAG, "NVS erase failed");
    }

    vTaskDelay(pdMS_TO_TICKS(500));
    esp_restart();
}



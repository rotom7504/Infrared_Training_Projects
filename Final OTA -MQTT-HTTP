/* ---------------- OTA POST-BOOT VALIDATION ---------------- */

static void ota_validation_task(void *arg)
{
    ESP_LOGI(TAG, "OTA validation task running");

    /* Grace window for system to stabilize */
    vTaskDelay(pdMS_TO_TICKS(20000));

    bool time_ok = time_sync_is_valid();
    bool mqtt_ok = mqtt_is_connected();

    ESP_LOGI(TAG, "OTA validation: time=%d mqtt=%d",
             time_ok, mqtt_ok);

    if (time_ok && mqtt_ok) {
        ESP_LOGW(TAG, "AUDIT: OTA image marked VALID");
        esp_ota_mark_app_valid_cancel_rollback();
    } else {
        ESP_LOGE(TAG, "AUDIT: OTA validation failed → rollback on reboot");
    }

    vTaskDelete(NULL);
}

/* ---------------- APP MAIN ---------------- */

void app_main(void)
{
    ESP_LOGI(TAG, "System boot");

    /* ---------------- NVS ---------------- */
    esp_err_t ret = nvs_flash_init();
    if (ret == ESP_ERR_NVS_NO_FREE_PAGES ||
        ret == ESP_ERR_NVS_NEW_VERSION_FOUND) {
        ESP_ERROR_CHECK(nvs_flash_erase());
        ESP_ERROR_CHECK(nvs_flash_init());
    }

    /* ---------------- IDENTITY ---------------- */
    device_identity_init();

    /* ---------------- RELIABILITY ---------------- */
    reliability_init();

    /* ---------------- SECURITY AUDIT ---------------- */
    security_init();

    /* ---------------- SAFE MODE BRANCH ---------------- */
    if (reliability_is_safe_mode()) {
        ESP_LOGE(TAG, "SAFE MODE ACTIVE");

        wifi_manager_start_ap_only();
        http_server_start();

        /* Recovery-only loop */
        while (true) {
            vTaskDelay(pdMS_TO_TICKS(10000));
        }
    }

    /* ---------------- NORMAL MODE ---------------- */

    /* OTA state check */
    const esp_partition_t *running =
        esp_ota_get_running_partition();
    esp_ota_img_states_t state;

    if (esp_ota_get_state_partition(running, &state) == ESP_OK &&
        state == ESP_OTA_IMG_PENDING_VERIFY) {

        ESP_LOGW(TAG, "Running PENDING OTA image");
        xTaskCreate(
            ota_validation_task,
            "ota_validate",
            4096,
            NULL,
            5,
            NULL
        );
    }

    /* WiFi AP + STA */
    wifi_manager_start();

    /* SNTP (mandatory for TLS) */
    time_sync_start();

    /* MQTT (secure TLS) */
    mqtt_app_start();

    /* HTTP REST */
    http_server_start();

    ESP_LOGI(TAG, "System fully operational");

    while (true) {
        vTaskDelay(pdMS_TO_TICKS(10000));
    }
}



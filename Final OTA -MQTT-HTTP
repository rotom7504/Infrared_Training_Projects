static const char *TAG = "OTA_MANAGER";

/* ===== CHANGE ONLY THIS URL ===== */
static const char *OTA_URL =
    "https://192.168.1.11:8000/firmware.bin";
/* ================================= */

static esp_err_t http_event_handler(esp_http_client_event_t *evt)
{
    static int downloaded = 0;

    if (evt->event_id == HTTP_EVENT_ON_DATA) {
        downloaded += evt->data_len;
        ESP_LOGI(TAG, "OTA progress: %d bytes", downloaded);
    }
    return ESP_OK;
}

static bool check_new_version(const esp_app_desc_t *new_app)
{
    const esp_app_desc_t *running =
        esp_ota_get_app_description();

    ESP_LOGI(TAG, "Running version : %s", running->version);
    ESP_LOGI(TAG, "Incoming version: %s", new_app->version);

    if (strcmp(new_app->version, running->version) == 0) {
        ESP_LOGW(TAG, "Same version detected → OTA skipped");
        return false;
    }

    return true;
}

static void ota_task(void *arg)
{
    ESP_LOGW(TAG, "AUDIT: OTA started");

    esp_http_client_config_t http_cfg = {
        .url = OTA_URL,
        .timeout_ms = 30000,
        .event_handler = http_event_handler,
        .crt_bundle_attach = esp_crt_bundle_attach,
        .keep_alive_enable = true,
    };

    esp_https_ota_config_t ota_cfg = {
        .http_config = &http_cfg,
    };

    esp_https_ota_handle_t ota_handle = NULL;
    esp_err_t err = esp_https_ota_begin(&ota_cfg, &ota_handle);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "OTA begin failed: %s",
                 esp_err_to_name(err));
        goto exit;
    }

    esp_app_desc_t new_app;
    if (esp_https_ota_get_img_desc(ota_handle, &new_app) != ESP_OK) {
        ESP_LOGE(TAG, "Failed to read image descriptor");
        goto abort;
    }

    if (!check_new_version(&new_app)) {
        goto abort;
    }

    while (true) {
        err = esp_https_ota_perform(ota_handle);
        if (err != ESP_ERR_HTTPS_OTA_IN_PROGRESS)
            break;
    }

    if (err != ESP_OK) {
        ESP_LOGE(TAG, "OTA failed: %s",
                 esp_err_to_name(err));
        goto abort;
    }

    if (!esp_https_ota_is_complete_data_received(ota_handle)) {
        ESP_LOGE(TAG, "Incomplete OTA image received");
        goto abort;
    }

    if (esp_https_ota_finish(ota_handle) != ESP_OK) {
        ESP_LOGE(TAG, "OTA finish failed");
        goto exit;
    }

    ESP_LOGW(TAG, "AUDIT: OTA successful → rebooting");
    esp_restart();

abort:
    esp_https_ota_abort(ota_handle);

exit:
    vTaskDelete(NULL);
}

void ota_manager_start(void)
{
    xTaskCreate(
        ota_task,
        "ota_https_task",
        10240,
        NULL,
        5,
        NULL
    );
}



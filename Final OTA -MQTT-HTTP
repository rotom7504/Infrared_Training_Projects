static void check_secure_boot_status(void)
{
#if CONFIG_SECURE_BOOT_V2_ENABLED
    ESP_LOGI(TAG, "Secure Boot: ENABLED (V2)");
#elif CONFIG_SECURE_BOOT_ENABLED
    ESP_LOGI(TAG, "Secure Boot: ENABLED");
#else
    ESP_LOGW(TAG, "Secure Boot: DISABLED");
#endif
}

/* ---------------- FLASH ENCRYPTION ---------------- */

static void check_flash_encryption_status(void)
{
    if (esp_flash_encryption_enabled()) {
        ESP_LOGI(TAG, "Flash Encryption: ENABLED");
    } else {
        ESP_LOGW(TAG, "Flash Encryption: DISABLED");
    }
}

/* ---------------- JTAG STATUS ---------------- */
/* ESP32-S3 supports USB JTAG + PAD JTAG */

static void check_jtag_status(void)
{
    bool usb_jtag_disabled =
        esp_efuse_read_field_bit(ESP_EFUSE_DIS_USB_JTAG);
    bool pad_jtag_disabled =
        esp_efuse_read_field_bit(ESP_EFUSE_DIS_PAD_JTAG);

    if (usb_jtag_disabled && pad_jtag_disabled) {
        ESP_LOGI(TAG, "JTAG Debug: DISABLED (USB + PAD)");
    } else {
        ESP_LOGW(TAG,
                 "JTAG Debug: ENABLED (USB=%d PAD=%d)",
                 !usb_jtag_disabled,
                 !pad_jtag_disabled);
    }
}

/* ---------------- PUBLIC INIT ---------------- */

void security_init(void)
{
    ESP_LOGI(TAG, "Production Security Checks");

    check_secure_boot_status();
    check_flash_encryption_status();
    check_jtag_status();

    ESP_LOGI(TAG, "Security audit complete");
}



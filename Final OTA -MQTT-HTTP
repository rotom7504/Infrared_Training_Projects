/* Initialize reliability systems (boot guard + watchdog) */
void reliability_init(void);

/* Feed task watchdog (optional periodic call) */
void reliability_feed(void);

/* Check if system is in SAFE MODE */
bool reliability_is_safe_mode(void);

/* Print last reset reason */
void reliability_print_reset_reason(void);


#include "reliability.h"

#include "esp_log.h"
#include "esp_system.h"
#include "esp_task_wdt.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

static const char *TAG = "RELIABILITY";

/* RTC retained across resets */
RTC_DATA_ATTR static uint32_t boot_count = 0;
RTC_DATA_ATTR static bool safe_mode = false;

#define BOOT_FAIL_THRESHOLD 3

/* ---------------- RESET REASON ---------------- */

void reliability_print_reset_reason(void)
{
    esp_reset_reason_t reason = esp_reset_reason();

    const char *reason_str = "UNKNOWN";
    switch (reason) {
        case ESP_RST_POWERON:  reason_str = "POWERON"; break;
        case ESP_RST_EXT:      reason_str = "EXTERNAL"; break;
        case ESP_RST_SW:       reason_str = "SOFTWARE"; break;
        case ESP_RST_PANIC:    reason_str = "PANIC"; break;
        case ESP_RST_TASK_WDT: reason_str = "TASK_WDT"; break;
        case ESP_RST_INT_WDT:  reason_str = "INT_WDT"; break;
        case ESP_RST_WDT:      reason_str = "WDT"; break;
        case ESP_RST_BROWNOUT: reason_str = "BROWNOUT"; break;
        default: break;
    }

    ESP_LOGW(TAG, "RESET_REASON: %s (%d)", reason_str, reason);
}

/* ---------------- WATCHDOG ---------------- */

static void watchdog_attach(void)
{
    /* Watchdog already initialized by ESP-IDF */
    ESP_ERROR_CHECK(esp_task_wdt_add(NULL));
    ESP_LOGI(TAG, "Task watchdog attached");
}

void reliability_feed(void)
{
    esp_task_wdt_reset();
}

/* ---------------- BOOT GUARD ---------------- */

static void boot_guard_check(void)
{
    boot_count++;
    ESP_LOGW(TAG, "BOOT COUNT: %lu", boot_count);

    if (boot_count >= BOOT_FAIL_THRESHOLD) {
        safe_mode = true;
        ESP_LOGE(TAG, "AUDIT: SAFE MODE ENTERED");
    }
}

/* ---------------- PUBLIC API ---------------- */

bool reliability_is_safe_mode(void)
{
    return safe_mode;
}

void reliability_init(void)
{
    reliability_print_reset_reason();
    boot_guard_check();
    watchdog_attach();
}



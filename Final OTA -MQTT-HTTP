static const char *TAG = "HTTP_SERVER";

/* ================= AUTH ================= */

static char active_token[64];
static time_t last_ota_time = 0;
static time_t last_reboot_time = 0;

static void generate_token(void)
{
    uint32_t r = esp_random();
    snprintf(active_token, sizeof(active_token),
             "tok-%08lx", (unsigned long)r);

    ESP_LOGI(TAG, "Auth token generated");
}

static bool check_bearer_token(const char *auth)
{
    if (!auth) return false;
    if (strncmp(auth, "Bearer ", 7) != 0) return false;
    return strcmp(auth + 7, active_token) == 0;
}

bool http_auth_is_valid(const char *auth_header)
{
    return check_bearer_token(auth_header);
}

static esp_err_t require_auth(httpd_req_t *req)
{
    char auth[128] = {0};

    if (httpd_req_get_hdr_value_str(req, "Authorization",
                                   auth, sizeof(auth)) != ESP_OK) {
        httpd_resp_send_err(req, HTTPD_401_UNAUTHORIZED,
                            "Missing Authorization");
        return ESP_FAIL;
    }

    if (!check_bearer_token(auth)) {
        httpd_resp_send_err(req, HTTPD_403_FORBIDDEN,
                            "Invalid token");
        return ESP_FAIL;
    }

    return ESP_OK;
}

/* ================= HELPERS ================= */

static esp_err_t send_json(httpd_req_t *req, const char *json)
{
    httpd_resp_set_type(req, "application/json");
    return httpd_resp_sendstr(req, json);
}

/* ================= API HANDLERS ================= */

static esp_err_t api_system_info(httpd_req_t *req)
{
    char resp[256];
    snprintf(resp, sizeof(resp),
             "{ \"device\": \"%s\", \"heap\": %lu }",
             device_identity_get_id(),
             esp_get_free_heap_size());

    return send_json(req, resp);
}

static esp_err_t api_network_status(httpd_req_t *req)
{
    esp_netif_ip_info_t ip;
    esp_netif_t *netif =
        esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");

    if (!netif || esp_netif_get_ip_info(netif, &ip) != ESP_OK) {
        return send_json(req, "{ \"connected\": false }");
    }

    char resp[128];
    snprintf(resp, sizeof(resp),
             "{ \"connected\": true, \"ip\": \"%d.%d.%d.%d\" }",
             IP2STR(&ip.ip));

    return send_json(req, resp);
}

static esp_err_t api_time_status(httpd_req_t *req)
{
    char resp[64];
    snprintf(resp, sizeof(resp),
             "{ \"time_valid\": %s }",
             time_sync_is_valid() ? "true" : "false");

    return send_json(req, resp);
}

static esp_err_t api_auth_login(httpd_req_t *req)
{
    char resp[128];
    snprintf(resp, sizeof(resp),
             "{ \"token\": \"%s\" }", active_token);

    return send_json(req, resp);
}

static esp_err_t api_system_reboot(httpd_req_t *req)
{
    if (require_auth(req) != ESP_OK) return ESP_OK;

    if (reliability_is_safe_mode()) {
        httpd_resp_send_err(req, 403,
                            "Reboot disabled in safe mode");
        return ESP_OK;
    }

    time_t now = time(NULL);
    if (now - last_reboot_time < 60) {
        httpd_resp_send_err(req, 429,
                            "Reboot rate limited");
        return ESP_OK;
    }

    last_reboot_time = now;
    ESP_LOGW(TAG, "AUDIT: HTTP reboot requested");

    send_json(req, "{ \"status\": \"rebooting\" }");
    esp_restart();
    return ESP_OK;
}

static esp_err_t api_ota_trigger(httpd_req_t *req)
{
    if (require_auth(req) != ESP_OK) return ESP_OK;

    time_t now = time(NULL);
    if (now - last_ota_time < 300) {
        httpd_resp_send_err(req, 429,
                            "OTA rate limited");
        return ESP_OK;
    }

    last_ota_time = now;
    ESP_LOGW(TAG, "AUDIT: HTTP OTA triggered");

    send_json(req, "{ \"status\": \"ota_started\" }");
    ota_manager_start();
    return ESP_OK;
}

/* ================= SERVER START ================= */

void http_server_start(void)
{
    generate_token();

    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
    httpd_handle_t server = NULL;

    if (httpd_start(&server, &config) != ESP_OK) {
        ESP_LOGE(TAG, "Failed to start HTTP server");
        return;
    }

    httpd_register_uri_handler(server, &(httpd_uri_t){
        .uri = "/api/system/info",
        .method = HTTP_GET,
        .handler = api_system_info
    });

    httpd_register_uri_handler(server, &(httpd_uri_t){
        .uri = "/api/network/status",
        .method = HTTP_GET,
        .handler = api_network_status
    });

    httpd_register_uri_handler(server, &(httpd_uri_t){
        .uri = "/api/time/status",
        .method = HTTP_GET,
        .handler = api_time_status
    });

    httpd_register_uri_handler(server, &(httpd_uri_t){
        .uri = "/api/auth/login",
        .method = HTTP_POST,
        .handler = api_auth_login
    });

    httpd_register_uri_handler(server, &(httpd_uri_t){
        .uri = "/api/system/reboot",
        .method = HTTP_POST,
        .handler = api_system_reboot
    });

    httpd_register_uri_handler(server, &(httpd_uri_t){
        .uri = "/api/ota/trigger",
        .method = HTTP_POST,
        .handler = api_ota_trigger
    });

    ESP_LOGI(TAG, "HTTP server started (FINAL)");
}



/* ---------------- CONFIG ---------------- */
#define MQTT_BROKER_URI   "mqtts://e8d4f3dcfda3426baef2f2f4746d8134.s1.eu.hivemq.cloud:8883"
#define MQTT_USERNAME     "otamqtt"
#define MQTT_PASSWORD     "Raghav12"

#define HEARTBEAT_TOPIC   "device/heartbeat"
#define COMMAND_TOPIC     "device/cmd"

#define HEARTBEAT_PERIOD_SEC 30
/* --------------------------------------- */

static esp_mqtt_client_handle_t mqtt_client = NULL;
static bool mqtt_connected = false;
static esp_timer_handle_t heartbeat_timer;

/* ---------------- HEARTBEAT ---------------- */

static void heartbeat_timer_cb(void *arg)
{
    if (!mqtt_connected || !mqtt_client) return;

    char payload[128];
    snprintf(payload, sizeof(payload),
             "{ \"id\": \"%s\", \"status\": \"alive\" }",
             device_identity_get_id());

    esp_mqtt_client_publish(
        mqtt_client,
        HEARTBEAT_TOPIC,
        payload,
        0,
        1,
        0
    );

    ESP_LOGI(TAG, "Heartbeat sent");
}

/* ---------------- COMMAND HANDLER ---------------- */

static void handle_command(const char *cmd)
{
    ESP_LOGW(TAG, "AUDIT: MQTT command received: %s", cmd);

    if (strcmp(cmd, "reboot") == 0) {
        if (!reliability_is_safe_mode()) {
            ESP_LOGW(TAG, "Executing reboot");
            esp_restart();
        } else {
            ESP_LOGW(TAG, "Reboot blocked (safe mode)");
        }
    }
    else if (strcmp(cmd, "ota") == 0) {
        ESP_LOGW(TAG, "Executing OTA");
        ota_manager_start();
    }
    else if (strcmp(cmd, "factory_reset") == 0) {
        if (!reliability_is_safe_mode()) {
            ESP_LOGW(TAG, "Executing factory reset");
            esp_restart();
        }
    }
    else {
        ESP_LOGW(TAG, "Unknown command ignored");
    }
}

/* ---------------- MQTT EVENT HANDLER ---------------- */

static void mqtt_event_handler(void *handler_args,
                               esp_event_base_t base,
                               int32_t event_id,
                               void *event_data)
{
    esp_mqtt_event_handle_t event = event_data;

    switch ((esp_mqtt_event_id_t)event_id) {

    case MQTT_EVENT_CONNECTED:
        ESP_LOGI(TAG, "MQTT CONNECTED");
        mqtt_connected = true;

        esp_mqtt_client_subscribe(mqtt_client, COMMAND_TOPIC, 1);
        esp_timer_start_periodic(
            heartbeat_timer,
            HEARTBEAT_PERIOD_SEC * 1000000ULL
        );
        break;

    case MQTT_EVENT_DISCONNECTED:
        ESP_LOGW(TAG, "MQTT DISCONNECTED");
        mqtt_connected = false;
        esp_timer_stop(heartbeat_timer);
        break;

    case MQTT_EVENT_DATA:
        if (event->data_len < 64) {
            char cmd[64] = {0};
            memcpy(cmd, event->data, event->data_len);
            handle_command(cmd);
        }
        break;

    case MQTT_EVENT_ERROR:
        ESP_LOGE(TAG, "MQTT TRANSPORT ERROR");
        break;

    default:
        break;
    }
}

/* ---------------- START ---------------- */

void mqtt_app_start(void)
{
    esp_timer_create_args_t timer_args = {
        .callback = heartbeat_timer_cb,
        .name = "mqtt_heartbeat"
    };
    esp_timer_create(&timer_args, &heartbeat_timer);

    esp_mqtt_client_config_t cfg = {
        .broker.address.uri = MQTT_BROKER_URI,

        .credentials = {
            .username = MQTT_USERNAME,
            .authentication.password = MQTT_PASSWORD,
        },

        .broker.verification = {
            .crt_bundle_attach = esp_crt_bundle_attach,
        },

        .network = {
            .disable_auto_reconnect = false,
        },

        .session = {
            .keepalive = 60,
        }
    };

    mqtt_client = esp_mqtt_client_init(&cfg);

    esp_mqtt_client_register_event(
        mqtt_client,
        ESP_EVENT_ANY_ID,
        mqtt_event_handler,
        NULL
    );

    esp_mqtt_client_start(mqtt_client);

    ESP_LOGI(TAG, "Secure MQTT client started");
}

bool mqtt_is_connected(void)
{
    return mqtt_connected;
}


